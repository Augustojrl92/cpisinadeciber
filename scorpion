#!/usr/bin/env python3
"""Display image attributes and metadata (Arachnida Exercise 2)."""

from __future__ import annotations

import argparse
from pathlib import Path
import struct
import sys

from metadata_reader import ImageMetadataError, read_metadata


SUPPORTED_EXTENSIONS = {".jpg", ".jpeg", ".png", ".gif", ".bmp"}


def print_image(path: Path) -> bool:
    if path.suffix.lower() not in SUPPORTED_EXTENSIONS:
        print(f"[skip] Unsupported extension: {path}", file=sys.stderr)
        return False
    if not path.is_file():
        print(f"[skip] File not found: {path}", file=sys.stderr)
        return False

    try:
        result = read_metadata(path)
    except (OSError, ImageMetadataError, ValueError, struct.error) as exc:
        print(f"[error] Could not parse {path}: {exc}", file=sys.stderr)
        return False

    print(f"\n=== {path} ===")
    print(f"Format: {result['format']}")
    if result.get("width") and result.get("height"):
        print(f"Dimensions: {result['width']} x {result['height']}")
    print(f"File size: {path.stat().st_size} bytes")
    print(f"Creation date: {result.get('creation_date') or 'not present in metadata'}")

    metadata = result.get("metadata", {})
    if metadata:
        print("EXIF / image metadata:")
        for section, values in metadata.items():
            if isinstance(values, dict):
                if not values:
                    continue
                print(f"  {section}:")
                for name, value in values.items():
                    print(f"    {name}: {value}")
            else:
                print(f"  {section}: {values}")
    else:
        print("EXIF metadata: none found")
    return True


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="scorpion",
        description="Display basic attributes and EXIF metadata for image files.",
    )
    parser.add_argument("files", nargs="+", help="one or more image files")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    successes = sum(print_image(Path(name)) for name in args.files)
    return 0 if successes == len(args.files) else 1


if __name__ == "__main__":
    raise SystemExit(main())
